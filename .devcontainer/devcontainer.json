{
  "name": "sqlsentry",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -e '.[dev,anthropic]' && sqlsentry sample-db examples/store.db",
  "secrets": {
    "GROQ_API_KEY": {
      "description": "Free key from https://console.groq.com/keys, used for end-to-end runs (tests don't need it)."
    }
  },
  "containerEnv": {
    "SQLSENTRY_CONFIG": "examples/sqlsentry.yaml"
  },
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
