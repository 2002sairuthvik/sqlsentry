# Copy to .env (never commit .env). Only set what you use.

# Free tier for development: https://console.groq.com/keys
GROQ_API_KEY=

# Optional cloud providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Config file location (default: ./sqlsentry.yaml)
SQLSENTRY_CONFIG=examples/sqlsentry.yaml

# API key for the demo consumer in examples/sqlsentry.yaml (generate with `sqlsentry hash-key`)
SQLSENTRY_DEMO_KEY_SHA256=
